<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sae.parking</groupId>
    <artifactId>sae-parking</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>sae-parking</name>
    <description>SAE Parking project</description>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <sonar.organization>saeparking</sonar.organization>
        <sonar.projectKey>saeparking_parking</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>

        <sonar.coverage.inclusions>**/modele/**</sonar.coverage.inclusions>
        <sonar.coverage.exclusions>**/controleur/**/*, **/vue/**/*</sonar.coverage.exclusions>
    </properties>

    <dependencies>
        <!-- JUnit 4 pour les tests dans src/test -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler avec Java 21 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
            <!-- Surefire pour mieux interagir avec la base de données -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Bridge OS env vars into Java system properties available to tests -->
                    <systemPropertyVariables>
                        <!-- connection base de données -->
                        <DB_URL>${env.DB_URL}</DB_URL>
                        <DB_USER>${env.DB_USER}</DB_USER>
                        <DB_PASS>${env.DB_PASS}</DB_PASS>
                        <!-- Datasource override -->
                        <DB_DATASOURCE_CLASS>${env.DB_DATASOURCE_CLASS}</DB_DATASOURCE_CLASS>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- jacoco -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    
                    <!-- Attach agent -->
                    <execution>
                    <goals>
                        <goal>prepare-agent</goal>
                    </goals>
                    </execution>

                    <!-- Generate report -->
                    <execution>
                    <id>report</id>
                    <phase>verify</phase>
                    <goals>
                        <goal>report</goal>
                    </goals>
                    </execution>

                </executions>
                </plugin>
        </plugins>
    </build>

</project>
